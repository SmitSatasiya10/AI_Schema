            "text": "<p>The vegetables stay fresh for weeks! You can tell they were picked just hours before delivery.</p>",
            "author": "James K.",
            "image": "",
            "star_rating": 5
          }
        },
        "column-3": {
          "type": "column",
          "settings": {
