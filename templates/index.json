          "settings": {
            "title": "From Farm to Fork, 100% Compassionate",
            "heading_size": "h2"
          }
        },
        "story-text": {
          "type": "text",
          "settings": {
            "text": "<p>We believe food should nourish both body and soul. Our journey began in a small kitchen with a simple mission: create plant-based alternatives so delicious, even dedicated meat-lovers make the switch. Today, we're proud to serve millions of families who choose kindness without sacrificing flavor.</p>"
          }
        },
        "story-button": {
          "type": "button",
          "settings": {
            "button_label": "Read Our Story",
            "button_link": "/pages/about-us",
            "button_style_secondary": "false"
          }
        }
      },
      "block_order": [
        "story-heading",
        "story-text",
        "story-button"
      ]
    },
