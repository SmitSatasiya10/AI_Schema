# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API Base URL (optional, defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Model to use (optional, defaults to openai/gpt-4-turbo)
# Options: openai/gpt-4, openai/gpt-3.5-turbo, anthropic/claude-2, etc.
# See https://openrouter.ai/models for all available models
# OPENROUTER_MODEL=openai/gpt-4-turbo

# Debug mode (optional, set to true to enable debug logging)
# DEBUG=false