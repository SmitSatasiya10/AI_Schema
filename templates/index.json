      "blocks": {
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Best tomatoes ever!",
            "text": "<p>I've never tasted tomatoes this sweet and juicy. Smit's produce reminds me of my grandmother's garden.</p>",
            "author": "Sarah M.",
            "image": "",
            "star_rating": 5
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
