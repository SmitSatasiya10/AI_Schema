            "content_position": "center"
          }
        },
        "slide-2": {
          "type": "slide",
          "settings": {
            "image": "",
            "heading": "Seasonal Tomatoes & Lemons",
            "subheading": "Sun-ripened and bursting with flavor",
            "text": "<p>From zesty lemons to juicy tomatoes, experience nature's candy at its peak ripeness.</p>",
            "button_label": "View Produce",
