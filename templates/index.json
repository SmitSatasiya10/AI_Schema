        "columns_desktop": 3,
        "show_stars": "true",
        "show_quotes": "true"
      },
      "blocks": {
        "review-1": {
          "type": "column",
          "settings": {
            "title": "Better Than Real Chicken",
            "text": "<p>I was skeptical about plant-based meat, but this tastes better than the real thing! My whole family requests the crispy tenders weekly. Game changer!</p>",
            "author": "Sarah M.",
            "star_rating": 5
          }
        },
        "review-2": {
          "type": "column",
          "settings": {
            "title": "Finally, Real Texture",
            "text": "<p>As a former meat-eater transitioning to veganism, finding alternatives with the right texture was hard. These products have the perfect bite and seasoning.</p>",
            "author": "Marcus T.",
            "star_rating": 5
          }
        },
        "review-3": {
          "type": "column",
          "settings": {
            "title": "My Kids Love It",
            "text": "<p>Getting my children to eat healthy was always a battle until we found these nuggets. They ask for them by name and I feel good about the ingredients.</p>",
            "author": "Jennifer K.",
            "star_rating": 5
          }
        }
      },
      "block_order": [
        "review-1",
        "review-2",
        "review-3"
      ]
