{%- style -%}
  .award-badge-container-{{ block.id }} {
    margin-top: {{ block.settings.margin_top | divided_by: 20.0 }}rem;
    margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;
    width: 100%;
    max-width: 100%;
    /* Ensure it doesn't overflow */
  }

  .award-gradient-border-{{ block.id }} {
    display: flex;
    align-items: stretch;
    border: 1px solid{{ block.settings.border_color }};
    border-radius: 8px;
    /* Slightly rounded corners */
    overflow: hidden;
    /* To clip the number badge background */
    background-color: {{ block.settings.bg_color }};
    width: fit-content;
  }

  .award-badge-content-{{ block.id }} {
    display: flex;
    flex-direction: row;
    width: 100%;
  }

  .award-number-badge-{{ block.id }} {
    background-color: {{ block.settings.badge_accent_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 0.5rem 1rem;
    font-weight: bold;
    font-size: 2.5rem;
    /* Adjust based on valid header sizes */
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 60px;
    /* Minimum width for the number part */
    word-break: break-word;
    overflow-wrap: break-word;
    white-space: normal;
    line-height: 30px;
    /* Adjust line height to prevent overflow */
  }

  .award-text-container-{{ block.id }} {
    padding: 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .award-title-{{ block.id }} {
    font-weight: bold;
    color: {{ block.settings.text_color }};
    font-size: 2rem;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 0.2rem;
  }

  .award-subtitle-{{ block.id }} {
    color: {{ block.settings.text_color }};
    font-size: 1.2rem;
    /* Slightly smaller */
    line-height: 1.2;
    font-style: italic;
  }
  /* Mobile responsive styles */
  @media (max-width: 768px) {
    .award-gradient-border-{{ block.id }} {
      flex-direction: column;
      width: 100%;
    }

    .award-badge-content-{{ block.id }} {
      flex-direction: column;
    }

    .award-number-badge-{{ block.id }} {
      font-size: 2rem;
      padding: 0.75rem 1rem;
      min-width: 100%;
      width: 100%;
      text-align: center;
      border-bottom: 1px solid{{ block.settings.border_color }};
      justify-content: left;
    }

    .award-text-container-{{ block.id }} {
      padding: 1rem;
      width: 100%;
    }

    .award-title-{{ block.id }} {
      font-size: 1.5rem;
    }

    .award-subtitle-{{ block.id }} {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .award-badge-container-{{ block.id }} {
      margin-top: {{ block.settings.margin_top | divided_by: 30.0 }}rem;
      margin-bottom: {{ block.settings.margin_bottom | divided_by: 20.0 }}rem;
    }

    .award-number-badge-{{ block.id }} {
      font-size: 1.75rem;
      padding: 0.5rem 0.75rem;
    }

    .award-text-container-{{ block.id }} {
      padding: 0.75rem;
    }

    .award-title-{{ block.id }} {
      font-size: 1.25rem;
    }

    .award-subtitle-{{ block.id }} {
      font-size: 0.9rem;
    }
  }
{%- endstyle -%}

<div class="award-badge-container award-badge-container-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="award-gradient-border award-gradient-border-{{ block.id }}">
    <div class="award-badge-content award-badge-content-{{ block.id }}">
      <div class="award-number-badge award-number-badge-{{ block.id }}">
        {{ block.settings.award_number }}
      </div>
      <div class="award-text-container award-text-container-{{ block.id }}">
        <div class="award-title award-title-{{ block.id }}">{{ block.settings.award_title }}</div>
        <div class="award-subtitle award-subtitle-{{ block.id }}">{{ block.settings.award_subtitle }}</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Award Badge",
  "settings": [
    {
      "type": "text",
      "id": "award_number",
      "label": "Badge Number",
      "default": "#1"
    },
    {
      "type": "text",
      "id": "award_title",
      "label": "Title",
      "default": "BESTSELLER OF 2025"
    },
    {
      "type": "text",
      "id": "award_subtitle",
      "label": "Subtitle",
      "default": "The ultimate heated blanket for cozy comfort"
    },
    {
      "type": "color",
      "id": "badge_accent_color",
      "label": "Badge Accent Color",
      "default": "#C88585"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Number Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#C88585"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Top",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Award Badge",
      "category": "Product"
    }
  ]
}
{% endschema %}
