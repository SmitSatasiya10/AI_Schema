          "type": "icon_with_text",
          "settings": {
            "icon": "spa",
            "filled_icon": true,
            "title": "100% Organic Ingredients",
            "text": "<p>USDA certified organic chicken, vegetables, and ancient grains. No artificial preservatives or fillers.</p>"
