        "tabs": {
          "type": "product_tabs",
          "settings": {
            "visibility": "always-display",
            "tab_text_size": 16,
            "tab_text_size_mobile": 14,
            "button_alignment": "left",
            "divider_thickness": 2,
            "active_indicator_thickness": 3,
            "content_size": 16,
            "margin_top": 30,
            "margin_bottom": 30
          },
          "blocks": {
            "tab-feeding": {
              "type": "tab_content",
              "settings": {
                "title": "Feeding Guide",
                "icon": "restaurant",
                "content": "<p><strong>Puppies (2-12 months):</strong> Feed 3-4 times daily, 1/2 to 2 cups per meal depending on breed size.</p><p><strong>Adults (1-7 years):</strong> Feed twice daily, 1 to 3 cups per meal based on weight and activity level.</p><p><strong>Seniors (7+ years):</strong> Feed twice daily, slightly reduced portions. Consult your vet for specific needs.</p><p>Always provide fresh water. Transition over 7 days mixing with previous food.</p>"
              }
            },
            "tab-ingredients": {
              "type": "tab_content",
              "settings": {
                "title": "Ingredients",
                "icon": "eco",
                "content": "<p><strong>Primary Ingredients:</strong> Organic free-range chicken, organic sweet potatoes, organic peas, organic lentils, organic chicken liver.</p><p><strong>Superfood Blend:</strong> Organic blueberries, organic spinach, organic kale, organic pumpkin.</p><p><strong>Supplements:</strong> Salmon oil, vitamin E, zinc proteinate, iron proteinate, copper proteinate.</p><p>Certified Organic by USDA. No corn, wheat, soy, or artificial ingredients.</p>"
              }
            },
            "tab-shipping": {
              "type": "tab_content",
              "settings": {
                "title": "Shipping & Returns",
                "icon": "local_shipping",
                "content": "<p><strong>Shipping:</strong> Orders ship within 1-2 business days. Free shipping on orders over $35. Subscription orders always ship free.</p><p><strong>Returns:</strong> 30-day satisfaction guarantee. If your dog doesn't love it, contact us for a full refund or exchange.</p><p><strong>Subscription Management:</strong> Modify, skip, or cancel your subscription anytime from your account dashboard.</p>"
              }
            }
          },
          "block_order": [
            "tab-feeding",
            "tab-ingredients",
            "tab-shipping"
          ]
        },
        "faq-1": {
          "type": "collapsible-row",
          "settings": {
            "heading": "Is this suitable for puppies?",
            "content": "<p>Yes! Our formula meets AAFCO nutritional standards for all life stages, including growth for puppies. We recommend the feeding guidelines specific to puppies (under 12 months) found in our feeding guide tab. The smaller kibble size and balanced nutrients support healthy development.</p>",
            "icon": "info",
            "open": false,
            "heading_size": 16,
            "margin_top": 15,
            "margin_bottom": 15
          }
        },
        "faq-2": {
          "type": "collapsible-row",
          "settings": {
            "heading": "How long does an opened bag stay fresh?",
            "content": "<p>Unopened bags have a shelf life of 12 months from the production date. Once opened, we recommend using the food within 6 weeks for optimal freshness. Reseal the bag tightly after each use and store in a cool, dry place away from direct sunlight. For maximum freshness, you can store the bag in an airtight container.</p>",
            "icon": "package",
            "open": false,
            "heading_size": 16,
            "margin_top": 15,
            "margin_bottom": 15
          }
        },
        "faq-3": {
          "type": "collapsible-row",
          "settings": {
            "heading": "What if my dog doesn't like the food?",
            "content": "<p>We offer a 30-day satisfaction guarantee. If your dog isn't completely satisfied, contact our customer care team for a full refund or exchange. For picky eaters, we recommend transitioning gradually over 7-10 days and mixing with their previous food. Most dogs love the taste, but we're here to help if yours needs time to adjust.</p>",
            "icon": "return",
            "open": false,
            "heading_size": 16,
            "margin_top": 15,
            "margin_bottom": 15
          }
        },
